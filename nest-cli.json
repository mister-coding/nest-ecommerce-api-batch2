{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/nest-microservices/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/nest-microservices/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/nest-microservices",
  "projects": {
    "nest-microservices": {
      "type": "application",
      "root": "apps/nest-microservices",
      "entryFile": "main",
      "sourceRoot": "apps/nest-microservices/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nest-microservices/tsconfig.app.json"
      }
    },
    "auth": {
      "type": "application",
      "root": "apps/auth",
      "entryFile": "main",
      "sourceRoot": "apps/auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth/tsconfig.app.json"
      }
    },
    "user": {
      "type": "application",
      "root": "apps/user",
      "entryFile": "main",
      "sourceRoot": "apps/user/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user/tsconfig.app.json"
      }
    },
    "product": {
      "type": "application",
      "root": "apps/product",
      "entryFile": "main",
      "sourceRoot": "apps/product/src",
      "compilerOptions": {
        "tsConfigPath": "apps/product/tsconfig.app.json"
      }
    },
    "order": {
      "type": "application",
      "root": "apps/order",
      "entryFile": "main",
      "sourceRoot": "apps/order/src",
      "compilerOptions": {
        "tsConfigPath": "apps/order/tsconfig.app.json"
      }
    },
    "payment": {
      "type": "application",
      "root": "apps/payment",
      "entryFile": "main",
      "sourceRoot": "apps/payment/src",
      "compilerOptions": {
        "tsConfigPath": "apps/payment/tsconfig.app.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "s3": {
      "type": "library",
      "root": "libs/s3",
      "entryFile": "index",
      "sourceRoot": "libs/s3/src",
      "compilerOptions": {
        "tsConfigPath": "libs/s3/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "prisma": {
      "type": "library",
      "root": "libs/prisma",
      "entryFile": "index",
      "sourceRoot": "libs/prisma/src",
      "compilerOptions": {
        "tsConfigPath": "libs/prisma/tsconfig.lib.json"
      }
    },
    "repository-product": {
      "type": "library",
      "root": "libs/repository-product",
      "entryFile": "index",
      "sourceRoot": "libs/repository-product/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repository-product/tsconfig.lib.json"
      }
    },
    "repository-user": {
      "type": "library",
      "root": "libs/repository-user",
      "entryFile": "index",
      "sourceRoot": "libs/repository-user/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repository-user/tsconfig.lib.json"
      }
    },
    "repository-media": {
      "type": "library",
      "root": "libs/repository-media",
      "entryFile": "index",
      "sourceRoot": "libs/repository-media/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repository-media/tsconfig.lib.json"
      }
    },
    "repository-report": {
      "type": "library",
      "root": "libs/repository-report",
      "entryFile": "index",
      "sourceRoot": "libs/repository-report/src",
      "compilerOptions": {
        "tsConfigPath": "libs/repository-report/tsconfig.lib.json"
      }
    }
  }
}