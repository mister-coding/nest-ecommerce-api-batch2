{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/repositories": [
        "libs/repositories/src"
      ],
      "@app/repositories/*": [
        "libs/repositories/src/*"
      ],
      "@app/cache": [
        "libs/cache/src"
      ],
      "@app/cache/*": [
        "libs/cache/src/*"
      ],
      "@app/s3": [
        "libs/s3/src"
      ],
      "@app/s3/*": [
        "libs/s3/src/*"
      ],
      "@app/common": [
        "libs/common/src"
      ],
      "@app/common/*": [
        "libs/common/src/*"
      ],
      "@app/prisma": [
        "libs/prisma/src"
      ],
      "@app/prisma/*": [
        "libs/prisma/src/*"
      ],
      "@app/repositories/product-repository": [
        "libs/repositories/product-repository/src"
      ],
      "@app/repositories/product-repository/*": [
        "libs/repositories/product-repository/src/*"
      ],
      "@app/repository/product": [
        "libs/repository/product/src"
      ],
      "@app/repository/product/*": [
        "libs/repository/product/src/*"
      ],
      "@app/repository-product": [
        "libs/repository-product/src"
      ],
      "@app/repository-product/*": [
        "libs/repository-product/src/*"
      ],
      "@app/repository-user": [
        "libs/repository-user/src"
      ],
      "@app/repository-user/*": [
        "libs/repository-user/src/*"
      ],
      "@app/repository-media": [
        "libs/repository-media/src"
      ],
      "@app/repository-media/*": [
        "libs/repository-media/src/*"
      ],
      "@app/repository-report": [
        "libs/repository-report/src"
      ],
      "@app/repository-report/*": [
        "libs/repository-report/src/*"
      ]
    }
  }
}